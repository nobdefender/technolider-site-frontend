# Пример конфига nginx на сервере: /etc/nginx/sites-available/technolider
# Домен: npp-technolider.ru. HTTPS — через certbot:
#   sudo certbot --nginx -d npp-technolider.ru -d www.npp-technolider.ru

server {
    listen 80;
    listen [::]:80;
    server_name npp-technolider.ru www.npp-technolider.ru;

    # www → без www (после выпуска сертификата certbot добавит редирект на https)
    if ($host = www.npp-technolider.ru) {
        return 301 https://npp-technolider.ru$request_uri;
    }

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # статика Next.js — кэшировать на стороне nginx
    location /_next/static/ {
        proxy_pass         http://127.0.0.1:3000;
        proxy_set_header   Host $host;
        proxy_cache_valid  200 365d;
        add_header         Cache-Control "public, max-age=31536000, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 5m;
}
