# Публичный адрес сайта — используется в sitemap.xml, robots.txt, llms.txt, canonical и Open Graph
NEXT_PUBLIC_SITE_URL=https://example.ru

# Яндекс Метрика: номер счётчика (пусто — счётчик не подключается)
NEXT_PUBLIC_YM_ID=

# Подтверждение прав на сайт в Яндекс Вебмастере и Google Search Console (содержимое meta-тега)
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Порт на хосте, на котором docker compose публикует контейнер (только 127.0.0.1, наружу — через nginx)
SITE_PORT=3000
